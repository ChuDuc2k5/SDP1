<section class="max-w-4xl mx-auto px-6 py-10">
    <h1 class="text-3xl font-bold text-yellow-500 mb-6">
        Booking Details
    </h1>

    <a href="/booking"
        class="mb-6 inline-flex items-center rounded-lg border border-yellow-500 bg-stone-900 px-4 py-2 font-semibold text-yellow-500 transition hover:bg-yellow-500 hover:text-stone-950">
        &larr; Back to Bookings
    </a>

    <div class="bg-stone-800 p-6 rounded-xl border border-stone-700">

        {{#if rateSuccess}}
        <div class="bg-green-500/10 border border-green-500 text-green-400 px-4 py-2 rounded-lg mb-4">
            Rating submitted successfully.
        </div>
        {{/if}}

        {{#if rateUpdated}}
        <div class="bg-green-500/10 border border-green-500 text-green-400 px-4 py-2 rounded-lg mb-4">
            Rating updated successfully.
        </div>
        {{/if}}

        {{#if rateDeleted}}
        <div class="bg-green-500/10 border border-green-500 text-green-400 px-4 py-2 rounded-lg mb-4">
            Rating deleted successfully.
        </div>
        {{/if}}

        {{#if rateErrorMessage}}
        <div class="bg-red-500/10 border border-red-500 text-red-400 px-4 py-2 rounded-lg mb-4">
            {{rateErrorMessage}}
        </div>
        {{/if}}

        <h2 class="text-xl font-semibold mb-4">
            {{booking.cabin.name}}
        </h2>

        <div class="space-y-2 text-stone-300">
            <p><strong>Check-in:</strong> {{booking.startDate}}</p>
            <p><strong>Check-out:</strong> {{booking.endDate}}</p>
            <p><strong>Guests:</strong> {{booking.numGuests}}</p>
            <p><strong>Type:</strong> {{booking.type}}</p>
            <p><strong>Price:</strong> ${{booking.cabinPrice}}</p>
            <p><strong>Status:</strong>
                <span class="
                    {{#if (eq booking.status 'confirmed')}}text-green-400{{/if}}
                    {{#if (eq booking.status 'cancelled')}}text-red-400{{/if}}
                ">
                    {{booking.status}}
                </span>
            </p>
            <p><strong>Note:</strong> {{booking.observations}}</p>
        </div>

        <div class="mt-6 flex flex-wrap gap-4">
            {{#if booking.canEditBooking}}
            <a href="/booking/edit/{{booking._id}}"
                class="bg-yellow-500 text-black px-4 py-2 rounded-lg hover:bg-yellow-400">
                Edit Booking
            </a>
            {{/if}}

            {{#if booking.isCabinOwner}}
                {{#if booking.canConfirm}}
                <form action="/booking/{{booking._id}}/status" method="POST">
                    <input type="hidden" name="status" value="confirmed">
                    <button class="bg-green-600 px-4 py-2 rounded-lg hover:bg-green-500">
                        Confirm Booking
                    </button>
                </form>
                {{/if}}

                {{#if booking.canCheckIn}}
                <form action="/booking/{{booking._id}}/status" method="POST">
                    <input type="hidden" name="status" value="checked-in">
                    <button class="bg-green-600 px-4 py-2 rounded-lg hover:bg-green-500">
                        Check-in Guest
                    </button>
                </form>
                {{/if}}

                {{#if booking.canCancel}}
                <form action="/booking/{{booking._id}}/status" method="POST">
                    <input type="hidden" name="status" value="cancelled">
                    <button class="bg-red-600 px-4 py-2 rounded-lg hover:bg-red-500">
                        Cancel Booking
                    </button>
                </form>
                {{/if}}
            {{else}}
                {{#if booking.canCancelBooking}}
            <form action="/booking/edit/{{booking._id}}/cancel" method="POST">
                <button class="bg-red-600 px-4 py-2 rounded-lg hover:bg-red-500">
                    Cancel Booking
                </button>
            </form>
                {{/if}}
            {{/if}}
        </div>

        <div class="mt-8 pt-6 border-t border-stone-700">
            <h3 class="text-lg font-semibold text-yellow-400 mb-3">Your Rating</h3>

            {{#if existingRate}}
            <div class="bg-stone-900 border border-stone-700 rounded-lg p-4 space-y-3">
                <p><strong>Score:</strong> {{existingRate.rating}} / 5</p>
                <p>
                    <strong>Comment:</strong>
                    {{#if existingRate.comment}}{{existingRate.comment}}{{else}}No comment provided.{{/if}}
                </p>

                {{#if canManageRate}}
                <div class="flex flex-wrap gap-3 pt-2">
                    <button type="button"
                        onclick="document.getElementById('edit-rating-form').classList.toggle('hidden')"
                        class="bg-yellow-500 text-black px-4 py-2 rounded-lg hover:bg-yellow-400">
                        Edit Rating
                    </button>

                    <form action="/rates/{{existingRate._id}}/delete" method="POST"
                        onsubmit="return confirm('Delete this rating? This action cannot be undone.');">
                        <input type="hidden" name="bookingId" value="{{booking._id}}">
                        <button type="submit" class="bg-red-600 px-4 py-2 rounded-lg hover:bg-red-500">
                            Delete Rating
                        </button>
                    </form>
                </div>

                <form id="edit-rating-form" action="/rates/{{existingRate._id}}/update" method="POST"
                    class="hidden mt-4 pt-4 border-t border-stone-700 space-y-4">
                    <input type="hidden" name="bookingId" value="{{booking._id}}">

                    <div>
                        <label class="block text-sm mb-2" for="edit-rating-score">Rating (1-5)</label>
                        <select id="edit-rating-score" name="rating" required
                            class="w-full bg-stone-950 border border-stone-700 rounded-lg px-3 py-2">
                            <option value="5" {{#if (eq existingRate.rating 5)}}selected{{/if}}>5 - Excellent</option>
                            <option value="4" {{#if (eq existingRate.rating 4)}}selected{{/if}}>4 - Very good</option>
                            <option value="3" {{#if (eq existingRate.rating 3)}}selected{{/if}}>3 - Good</option>
                            <option value="2" {{#if (eq existingRate.rating 2)}}selected{{/if}}>2 - Fair</option>
                            <option value="1" {{#if (eq existingRate.rating 1)}}selected{{/if}}>1 - Poor</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm mb-2" for="edit-rating-comment">Comment</label>
                        <textarea id="edit-rating-comment" name="comment" rows="3" maxlength="500"
                            class="w-full bg-stone-950 border border-stone-700 rounded-lg px-3 py-2"
                            placeholder="Share your experience...">{{existingRate.comment}}</textarea>
                    </div>

                    <div class="flex flex-wrap gap-3">
                        <button type="submit" class="bg-yellow-500 text-black px-4 py-2 rounded-lg hover:bg-yellow-400">
                            Update Rating
                        </button>
                        <button type="button"
                            onclick="document.getElementById('edit-rating-form').classList.add('hidden')"
                            class="border border-stone-600 text-stone-300 px-4 py-2 rounded-lg hover:bg-stone-800">
                            Cancel
                        </button>
                    </div>
                </form>
                {{/if}}
            </div>
            {{else}}
                {{#if canRate}}
                <form action="/rates/submit" method="POST" class="space-y-4">
                    <input type="hidden" name="bookingId" value="{{booking._id}}">

                    <div>
                        <label class="block text-sm mb-2" for="new-rating-score">Rating (1-5)</label>
                        <select id="new-rating-score" name="rating" required class="w-full bg-stone-900 border border-stone-700 rounded-lg px-3 py-2">
                            <option value="">Select score</option>
                            <option value="5">5 - Excellent</option>
                            <option value="4">4 - Very good</option>
                            <option value="3">3 - Good</option>
                            <option value="2">2 - Fair</option>
                            <option value="1">1 - Poor</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm mb-2" for="new-rating-comment">Comment</label>
                        <textarea id="new-rating-comment" name="comment" rows="3" maxlength="500" class="w-full bg-stone-900 border border-stone-700 rounded-lg px-3 py-2" placeholder="Share your experience..."></textarea>
                    </div>

                    <button type="submit" class="bg-yellow-500 text-black px-4 py-2 rounded-lg hover:bg-yellow-400">
                        Submit Rating
                    </button>
                </form>
                {{/if}}
            {{/if}}
        </div>

    </div>
</section>
